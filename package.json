{
  "name": "bread-map",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @bread-map/web dev",
    "dev:worker": "corepack pnpm --filter @bread-map/worker dev",
    "ingest:catalog:fixture": "corepack pnpm --filter @bread-map/worker ingest:catalog:fixture",
    "smoke:catalog:live": "corepack pnpm --filter @bread-map/worker smoke:catalog:live",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "eslint . && corepack pnpm check:boundaries",
    "test": "vitest run",
    "test:catalog:feature3": "vitest run packages/contracts/src/store.test.ts packages/app-db/src/schema/stores.test.ts apps/worker/src/catalog/normalize-store.test.ts apps/worker/src/catalog/deduplicate-stores.test.ts apps/worker/src/catalog/classify-eligibility.test.ts apps/worker/src/catalog/publish-catalog.test.ts",
    "test:reviews:feature4": "vitest run packages/contracts/src/review.test.ts packages/raw-db/src/schema/reviews.test.ts apps/worker/src/reviews apps/worker/src/commands/discover-kakao-bakeries.test.ts apps/worker/src/commands/collect-reviews.test.ts",
    "test:reviews:year-sync": "vitest run packages/contracts/src/review.test.ts packages/raw-db/src/schema/reviews.test.ts apps/worker/src/reviews/review-dom-contract.test.ts apps/worker/src/reviews/extract-review-page.test.ts apps/worker/src/reviews/browser-session.test.ts apps/worker/src/reviews/review-sync-state.test.ts apps/worker/src/reviews/collect-store-reviews.test.ts apps/worker/src/reviews/run-review-batch.test.ts apps/worker/src/reviews/purge-expired-review-data.test.ts apps/worker/src/commands/collect-reviews.test.ts",
    "test:reviews:feature5": "vitest run packages/app-db/src/schema/reviews.test.ts packages/retrieval/src/sqlite-review-repository.test.ts apps/worker/src/reviews/publish-review.test.ts scripts/check-workspace-boundaries.test.ts",
    "test:search:feature6": "vitest run packages/contracts/src/search.test.ts packages/app-db/src/schema/search-evidence.test.ts apps/worker/src/catalog/publish-catalog.test.ts apps/worker/src/search-evidence/publish-search-evidence.test.ts apps/worker/src/commands/publish-search-evidence.test.ts packages/recommendation/src packages/retrieval/src/sqlite-review-repository.test.ts packages/retrieval/src/sqlite-store-search-repository.test.ts packages/retrieval/src/execute-store-search.test.ts packages/retrieval/src/search-evaluation.test.ts scripts/check-workspace-boundaries.test.ts",
    "test:auth:feature7": "vitest run packages/contracts/src/user-data.test.ts packages/app-db/src/schema/auth.test.ts packages/app-db/src/schema/user-data.test.ts apps/web/src/server/auth-adapter.test.ts apps/web/src/server/session-registry.test.ts apps/web/src/auth.test.ts apps/web/src/app/api/auth/[...nextauth]/route.test.ts apps/web/src/server/authenticated-request.test.ts apps/web/src/server/user-repository.test.ts apps/web/src/app/api/favorites/route.test.ts apps/web/src/app/api/history/route.test.ts apps/web/src/server/kakao-unlink.test.ts apps/web/src/app/api/account/route.test.ts",
    "test:map:feature8": "vitest run packages/contracts/src/api/store-search.test.ts packages/contracts/src/api/store-detail.test.ts packages/retrieval/src/execute-store-search.test.ts apps/web/src/server/search-service.test.ts apps/web/src/server/store-detail-service.test.ts apps/web/src/server/store-api.integration.test.ts apps/web/src/app/api/stores/route.test.ts apps/web/src/app/api/stores/[storeId]/route.test.ts scripts/check-workspace-boundaries.test.ts",
    "test:ui:feature9": "corepack pnpm --filter @bread-map/web exec playwright test",
    "test:release:feature10": "vitest run apps/worker/src/recovery/restore-app-database.test.ts apps/worker/src/recovery/verify-review-resume.test.ts apps/web/src/auth-error.test.ts scripts/audit-local-mvp-release.test.ts scripts/prepare-local-mvp-fixture.test.ts scripts/search-quality-report.test.ts scripts/verify-local-mvp.test.ts",
    "verify:local-mvp": "tsx scripts/verify-local-mvp.ts",
    "test:watch": "vitest",
    "check:boundaries": "tsx scripts/check-workspace-boundaries.ts",
    "db:migrate": "tsx scripts/migrate-databases.ts",
    "db:backup:app": "tsx scripts/backup-app-database.ts",
    "db:generate:app": "drizzle-kit generate --name=storage_metadata --config=drizzle/app.config.ts",
    "db:generate:raw": "drizzle-kit generate --name=storage_metadata --config=drizzle/raw.config.ts",
    "db:generate": "corepack pnpm db:generate:app && corepack pnpm db:generate:raw",
    "db:check:app": "drizzle-kit check --config=drizzle/app.config.ts",
    "db:check:raw": "drizzle-kit check --config=drizzle/raw.config.ts",
    "db:check": "corepack pnpm db:check:app && corepack pnpm db:check:raw"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
