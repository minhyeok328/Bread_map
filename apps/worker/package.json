{
  "name": "@bread-map/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "ingest:catalog:fixture": "tsx src/commands/ingest-catalog.ts --fixture src/catalog/__fixtures__/localdata-seoul.json",
    "smoke:catalog:live": "tsx src/commands/ingest-catalog.ts --live",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bread-map/app-db": "workspace:*",
    "@bread-map/contracts": "workspace:*",
    "@bread-map/raw-db": "workspace:*",
    "@bread-map/recommendation": "workspace:*",
    "playwright": "catalog:",
    "proj4": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bread-map/testkit": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
