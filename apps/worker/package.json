{
  "name": "@bread-map/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "ingest:catalog:fixture": "tsx src/commands/ingest-catalog.ts --fixture src/catalog/__fixtures__/localdata-seoul.json",
    "publish:search-evidence": "tsx src/commands/publish-search-evidence.ts",
    "smoke:catalog:live": "tsx src/commands/ingest-catalog.ts --live",
    "discover:kakao:fixture": "tsx src/commands/discover-kakao-bakeries.ts --fixture src/reviews/__fixtures__/kakao-place-pages.json",
    "collect:reviews:fixture": "tsx src/commands/collect-reviews.ts --fixture src/reviews/__fixtures__/review-page-v1.html --selector-contract src/reviews/__fixtures__/selector-contract-v2.json",
    "smoke:kakao:live": "tsx src/commands/collect-reviews.ts --live --acknowledge-policy-risk --acknowledge-expanded-volume-risk --one-page --run-budget-minutes 60",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bread-map/app-db": "workspace:*",
    "@bread-map/contracts": "workspace:*",
    "@bread-map/raw-db": "workspace:*",
    "@bread-map/recommendation": "workspace:*",
    "@bread-map/retrieval": "workspace:*",
    "playwright": "catalog:",
    "proj4": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bread-map/testkit": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
