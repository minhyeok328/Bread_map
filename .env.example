# Local SQLite files. Defaults are used when blank.
APP_SQLITE_PATH=./var/app.sqlite

# Worker only. Never expose this variable to apps/web.
RAW_SQLITE_PATH=./var/raw.sqlite

# Kakao Login and Maps
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000

# Public data APIs
DATA_GO_KR_SERVICE_KEY=

# Worker-only Kakao discovery and review collection
KAKAO_REST_API_KEY=
REVIEW_POLICY_SNAPSHOT_ID=
REVIEW_ENCRYPTION_KEY_BASE64=
REVIEW_HMAC_KEY_BASE64=
REVIEW_KEY_VERSION=
KAKAO_REVIEW_SELECTOR_CONTRACT_PATH=
